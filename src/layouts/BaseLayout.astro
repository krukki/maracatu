---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { url } from '../lib/url';
import { ClientRouter } from 'astro:transitions';
import fonteTitulo from '@fontsource/gloock/files/gloock-latin-400-normal.woff2?url';
import fonteTexto from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';

interface Props {
  titulo: string;
  descricao: string;
  baque?: 'nacao' | 'rural' | 'comum';
  rota: string;
  migalhas?: { nome: string; rota: string }[];
  /** Página de tom calmo (conteúdo religioso): animações mínimas */
  calmo?: boolean;
}
const { titulo, descricao, baque = 'comum', rota, migalhas = [], calmo = false } = Astro.props;
const NOME = 'Dois Baques';
const tituloCompleto = rota === '/' ? `${NOME}: Maracatu Nação e Maracatu Rural de Pernambuco` : `${titulo} | ${NOME}`;
const canonica = new URL(url(rota), Astro.site).href;
const imagemOG = new URL(url('/og.png'), Astro.site).href;

const jsonLd = rota === '/'
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: NOME,
      url: canonica,
      inLanguage: 'pt-BR',
      description: descricao,
    }
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Article',
          headline: titulo,
          description: descricao,
          inLanguage: 'pt-BR',
          url: canonica,
          image: imagemOG,
          author: { '@type': 'Person', name: 'Ronaldo Heitor' },
          isPartOf: { '@type': 'WebSite', name: NOME, url: new URL(url('/'), Astro.site).href },
        },
        {
          '@type': 'BreadcrumbList',
          itemListElement: [{ nome: 'Início', rota: '/' }, ...migalhas, { nome: titulo, rota }].map((m, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: m.nome,
            item: new URL(url(m.rota), Astro.site).href,
          })),
        },
      ],
    };
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <link rel="preload" href={fonteTitulo} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fonteTexto} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#f6efe2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17120f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={rota === '/' ? 'website' : 'article'} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={NOME} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemOG} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dois Baques: faixas com o cordame da alfaia e as lantejoulas da gola do caboclo de lança" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Aplica o tema salvo antes de pintar a página (evita "piscar") e de novo a cada troca de página.
      (function () {
        function aplicar(raiz) {
          try {
            var t = localStorage.getItem('tema');
            if (t === 'claro' || t === 'escuro') raiz.dataset.tema = t;
          } catch (e) { /* armazenamento indisponível */ }
          raiz.classList.add('js');
        }
        aplicar(document.documentElement);
        if (!window.__temaPronto) {
          window.__temaPronto = true;
          document.addEventListener('astro:after-swap', function () { aplicar(document.documentElement); });
        }
      })();
    </script>
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-baque={baque} data-calmo={calmo ? '' : undefined}>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader rota={rota} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
