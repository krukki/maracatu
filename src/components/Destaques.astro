---
/**
 * "Em 30 segundos": blocos grandes e coloridos com os fatos-chave da página.
 * Uso no MDX: <Destaques itens={[{ grande: 'Só percussão', texto: 'Tambores, sinos e chocalhos.' }, ...]} />
 * - grande: até ~3 palavras ou um número (números contam até o valor quando aparecem na tela)
 * - tradicao (opcional, para páginas comuns): pinta o bloco com a cor da tradição
 */
interface Item { grande: string; texto: string; tradicao?: 'nacao' | 'rural' }
interface Props { itens: Item[]; titulo?: string }
const { itens, titulo = 'Em 30 segundos' } = Astro.props;
const numero = (s: string) => /^\d{2,4}$/.test(s.trim());
---

<section class="destaques largo" aria-label={titulo}>
  <p class="destaques-titulo" aria-hidden="true">{titulo}</p>
  <ul>
    {itens.map((it, i) => (
      <li class:list={['destaque', `destaque--${(i % 4) + 1}`]} data-baque={it.tradicao}>
        <span class="destaque-grande">
          {numero(it.grande) ? (
            <><span class="contador" aria-hidden="true" data-alvo={it.grande}>{it.grande}</span><span class="sr-only">{it.grande}</span></>
          ) : it.grande}
        </span>
        <span class="destaque-texto">{it.texto}</span>
      </li>
    ))}
  </ul>
</section>

<script>
  // Contadores: sobem até o valor quando o bloco entra na tela (desligado com movimento reduzido).
  function iniciarContadores() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const els = document.querySelectorAll<HTMLElement>('.contador:not([data-pronto])');
    const obs = new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        obs.unobserve(el);
        const alvo = +el.dataset.alvo!;
        const inicio = alvo > 1000 ? alvo - 120 : 0;
        const t0 = performance.now();
        const passo = (t: number) => {
          const p = Math.min(1, (t - t0) / 1100);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(inicio + (alvo - inicio) * eased));
          if (p < 1) requestAnimationFrame(passo);
        };
        requestAnimationFrame(passo);
      });
    }, { threshold: 0.6 });
    els.forEach((el) => { el.dataset.pronto = ''; obs.observe(el); });
  }
  document.addEventListener('astro:page-load', iniciarContadores);
</script>

<style>
  .destaques { margin-block: var(--e-2) var(--e-5); }
  .destaques-titulo { font-weight: 700; font-size: var(--t-0); margin-bottom: var(--e-2); color: var(--tinta-suave); }
  .destaques ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--e-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
  }
  .destaque {
    --bg: var(--forte-1); --fg: var(--sobre-forte);
    background: var(--bg); color: var(--fg);
    border-radius: 14px;
    padding: var(--e-4) var(--e-3) var(--e-3);
    display: grid; align-content: space-between; gap: var(--e-3);
    min-height: 8.5rem;
    position: relative; overflow: hidden;
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--fg) 12%, transparent);
  }
  .destaque--2 { --bg: var(--forte-2); }
  .destaque--3 { --bg: var(--forte-3); --fg: var(--escuro-fixo); }
  .destaque--4 { --bg: var(--forte-4); --fg: var(--sobre-forte); }
  :global([data-baque='nacao']) .destaque--4, :global(body[data-baque='comum']) .destaque--4 { --fg: var(--tinta); box-shadow: inset 0 0 0 2px var(--acento); }
  .destaque[data-baque='nacao'] { --bg: var(--nacao-f1); --fg: var(--sobre-forte); }
  .destaque[data-baque='rural'] { --bg: var(--rural-f1); --fg: var(--sobre-forte); }
  .destaque::after {
    /* brilho que cruza o bloco ao passar o mouse */
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.22) 50%, transparent 65%);
    transform: translateX(-110%);
    pointer-events: none;
  }
  .destaque-grande { font-family: var(--fonte-titulo); font-size: clamp(1.45rem, 5vw, 2.3rem); line-height: 1.05; }
  .destaque-texto { font-size: var(--t-0); line-height: 1.45; font-weight: 600; }
  @media (prefers-reduced-motion: no-preference) {
    .destaque { transition: transform 0.25s cubic-bezier(.2,.9,.3,1.3); }
    .destaque:hover { transform: translateY(-4px) rotate(-0.6deg); }
    .destaque:hover::after { transform: translateX(110%); transition: transform 0.7s ease; }
    @supports (animation-timeline: view()) {
      .destaque { animation: destaque-entra linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; }
      .destaque--2 { animation-range: entry 5% entry 85%; }
      .destaque--3 { animation-range: entry 10% entry 90%; }
      .destaque--4 { animation-range: entry 15% entry 95%; }
    }
  }
  @keyframes destaque-entra {
    from { transform: translateY(40px) scale(0.92) rotate(-2deg); }
    to { transform: none; }
  }
</style>
