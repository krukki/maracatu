---
/** Ficha de personagem ou instrumento: nome, ilustração opcional (slot "ilustracao") e descrição. */
interface Props { nome: string; outrosNomes?: string; id?: string }
const { nome, outrosNomes, id } = Astro.props;
const temIlustracao = Astro.slots.has('ilustracao');
---

<article class:list={['ficha', { 'ficha--ilustrada': temIlustracao }]} id={id}>
  {temIlustracao && <div class="ficha-ilustracao"><slot name="ilustracao" /></div>}
  <div class="ficha-texto">
    <h3>{nome}</h3>
    {outrosNomes && <p class="ficha-outros">{outrosNomes}</p>}
    <div class="ficha-corpo"><slot /></div>
  </div>
</article>

<style>
  .ficha {
    max-width: var(--medida);
    padding-block: var(--e-4);
    border-bottom: 1px solid var(--linha);
    display: grid;
    gap: var(--e-4);
    scroll-margin-top: var(--e-6);
  }
  @media (min-width: 36rem) {
    .ficha--ilustrada { grid-template-columns: 7rem 1fr; align-items: start; }
  }
  .ficha-ilustracao {
    width: 7rem;
    color: var(--tinta);
  }
  .ficha-ilustracao :global(svg) { width: 100%; height: auto; display: block; }
  .ficha h3 { font-size: var(--t-2); }
  .ficha-outros { font-size: var(--t-0); color: var(--tinta-suave); margin-top: var(--e-1); }
  .ficha-corpo { margin-top: var(--e-2); display: grid; gap: var(--e-2); }
</style>
