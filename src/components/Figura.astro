---
/**
 * Foto com crédito e licença visíveis. Uso no MDX: <Figura id="caboclo-camelo" />
 * Os dados (arquivo, texto alternativo, autor, licença) ficam em src/data/imagens.ts.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imagemPorId } from '../data/imagens';

interface Props { id: string; legenda?: string; largo?: boolean; prioridade?: boolean }
const { id, legenda, largo = false, prioridade = false } = Astro.props;
const img = imagemPorId(id);
const arquivos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.{jpg,jpeg,png,webp}', { eager: true });
const arquivo = arquivos[`../assets/fotos/${img.arquivo}`];
if (!arquivo) throw new Error(`Arquivo de imagem não encontrado: ${img.arquivo}`);
---

<figure class:list={['figura', { largo }]} data-tradicao={img.tradicao}>
  <Image
    src={arquivo.default}
    alt={img.alt}
    widths={[480, 800, 1200]}
    sizes={largo ? '(min-width: 76rem) 72rem, calc(100vw - 2rem)' : '(min-width: 64rem) 42rem, calc(100vw - 2rem)'}
    loading={prioridade ? 'eager' : 'lazy'}
    fetchpriority={prioridade ? 'high' : 'auto'}
    format="webp"
    quality={72}
  />
  <figcaption>
    {legenda ?? img.legenda} Foto: {img.autor}, <a href={img.origem} rel="noopener">{img.licenca}</a>, via Wikimedia Commons.
  </figcaption>
</figure>

<style>
  .figura { margin: var(--e-3) 0; max-width: var(--medida); }
  .figura.largo { max-width: 60rem; }
  .figura :global(img) { width: 100%; height: auto; border-radius: var(--raio); background: var(--papel-2); }
  .figura figcaption { margin-top: var(--e-2); }
</style>
