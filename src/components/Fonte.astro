---
/**
 * Chamada de fonte numerada. Uso no MDX: <Fonte id="palmares-2014" />
 * - No texto: número sobrescrito que leva à lista "Fontes desta página".
 * - No desktop (≥1024px): a nota aparece também na margem, ao lado do parágrafo.
 */
import { fontePorId } from '../data/fontes';

interface Props { id: string; detalhe?: string }
const { id, detalhe } = Astro.props;
const fonte = fontePorId(id);

const locals = Astro.locals as { notas?: { id: string; detalhe?: string }[] };
locals.notas ??= [];
let indice = locals.notas.findIndex((n) => n.id === id);
if (indice === -1) { locals.notas.push({ id, detalhe }); indice = locals.notas.length - 1; }
const n = indice + 1;
---

<sup class="fonte-ref"><a href={`#nota-${n}`} aria-label={`Fonte ${n}: ${fonte.autor}`}>{n}</a></sup><span class="fonte-margem" aria-hidden="true"><span class="fonte-num">{n}</span> {fonte.autor}, <em>{fonte.titulo}</em>{fonte.ano !== 's.d.' && `, ${fonte.ano}`}{detalhe && ` (${detalhe})`}.</span>

<style>
  .fonte-ref { line-height: 0; font-size: 0.72em; font-weight: 700; }
  .fonte-ref a {
    display: inline-block;
    min-width: 1.4em;
    padding: 0.35em 0.15em;
    text-align: center;
    text-decoration: none;
    color: var(--acento-texto);
  }
  .fonte-ref a:hover { text-decoration: underline; }
  .fonte-margem { display: none; }

  @media (min-width: 64rem) {
    .fonte-margem {
      display: block;
      float: right;
      clear: right;
      width: 15rem;
      margin-right: -18rem;
      margin-top: 0.2rem;
      font-size: var(--t-0);
      line-height: 1.4;
      color: var(--tinta-suave);
      font-weight: 400;
      font-style: normal;
    }
    .fonte-num { font-weight: 700; color: var(--acento-texto); }
  }
</style>
