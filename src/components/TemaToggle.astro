---
// Botão de tema claro/escuro. Segue o sistema até a pessoa escolher; a escolha fica salva no navegador.
---

<button class="tema-toggle botao" type="button" aria-label="Usar tema escuro" hidden>
  <span class="tema-icone" aria-hidden="true"></span>
  <span class="tema-texto">Tema</span>
</button>

<script>
  const raiz = document.documentElement;
  const escuroSistema = window.matchMedia('(prefers-color-scheme: dark)');
  const temaAtual = () => raiz.dataset.tema ?? (escuroSistema.matches ? 'escuro' : 'claro');
  function atualizar() {
    const botao = document.querySelector<HTMLButtonElement>('.tema-toggle');
    if (!botao) return;
    botao.setAttribute('aria-label', `Usar tema ${temaAtual() === 'escuro' ? 'claro' : 'escuro'}`);
    botao.dataset.tema = temaAtual();
  }
  document.addEventListener('astro:page-load', () => {
    const botao = document.querySelector<HTMLButtonElement>('.tema-toggle');
    if (!botao) return;
    botao.hidden = false;
    atualizar();
    botao.addEventListener('click', () => {
      const novo = temaAtual() === 'escuro' ? 'claro' : 'escuro';
      raiz.dataset.tema = novo;
      try { localStorage.setItem('tema', novo); } catch { /* armazenamento indisponível */ }
      atualizar();
    });
  });
  escuroSistema.addEventListener('change', atualizar);
</script>

<style>
  .tema-toggle { padding-inline: var(--e-3); border-width: 1.5px; font-weight: 600; }
  .tema-texto { font-size: var(--t-0); }
  @media (max-width: 40rem) {
    .tema-toggle { width: 44px; padding: 0; justify-content: center; }
    .tema-texto { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  .tema-icone {
    width: 1.1rem; height: 1.1rem; border-radius: 50%;
    border: 2px solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }
</style>
